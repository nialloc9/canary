# ---- API ----
API_BASE_URL=http://backend:8000/api/v1

# ---- Account ----
ACCOUNT_NAME=My Project
ACCOUNT_DOMAIN=myproject.dev
ACCOUNT_USERNAME=my-project
ACCOUNT_EMAIL=my-project@myproject.dev
ACCOUNT_PASSWORD=my-project-password!

# ---- GitHub ----
GITHUB_PAT=ghp_your_token_here
GITHUB_PROJECT_NAME=my-project
GITHUB_REPO_FULL_NAME=my-org/my-project-infra
GITHUB_BRANCH=develop
GITHUB_INFRA_BASE_PATH=infrastructure
GITHUB_API_URL=https://api.github.com
GITHUB_CREATE_CICD=true
GITHUB_AUTO_MERGE=false
GITHUB_SKIP_BOOTSTRAP=false
GITHUB_SKIP_MODULE_IMPORT=false

# ---- Warehouse ----
WAREHOUSE_NAME=my_project_wh
WAREHOUSE_TYPE=snowflake

# ---- Bootstrap (required when GITHUB_SKIP_BOOTSTRAP=false) ----
BOOTSTRAP_DEV_STATE_BUCKET=my-project-dev-terraform-state
BOOTSTRAP_DEV_STATE_REGION=eu-west-1
BOOTSTRAP_DEV_STATE_LOCK_TABLE=my-project-dev-terraform-lock
BOOTSTRAP_PROD_STATE_BUCKET=my-project-prod-terraform-state
BOOTSTRAP_PROD_STATE_REGION=eu-west-1
BOOTSTRAP_PROD_STATE_LOCK_TABLE=my-project-prod-terraform-lock

# ---- AWS ----
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ---- Snowflake ----
SNOWFLAKE_ORGANIZATION_NAME=your_org
SNOWFLAKE_ACCOUNT_NAME=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# base64-encode your PEM private key before setting this:
# base64 -i rsa_key.p8 | tr -d '\n'
SNOWFLAKE_PRIVATE_KEY_B64=your_base64_encoded_private_key
