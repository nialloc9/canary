# Copy to .env.local and fill in values.

# Set to "true" to run the frontend fully offline with mocked API responses.
# Useful for local UI development without a running backend.
VITE_MOCK_API=false

# Override the backend base URL (defaults to /api/v1 via the Vite proxy).
# VITE_API_URL=https://api.example.com/api/v1
